<header class="header{% if template == 'index' %} header--transparent{% endif %}">
  <div class="header__row wrap">
    <p class="header__title">
      {{ shop.name | link_to: routes.root_url }}
    </p>

    <details class="header__nav-toggle">
      <summary class="header__nav-toggle-button">
        {% render 'icon', name: 'menu' %}
        <span>{{ 'general.menu' | t }}</span>
      </summary>
    </details>

    <nav class="header__menu" aria-label="{{ 'general.menu' | t }}">
      {% for link in section.settings.menu.links %}
        {{ link.title | link_to: link.url }}
      {% endfor %}
    </nav>

    <div class="header__icons">
      {% if shop.customer_accounts_enabled %}
        <shopify-account
          class="header__icon-link"
          menu="{{ section.settings.customer_account_menu }}"
        >
          {% render 'icon', name: 'account' %}
        </shopify-account>
      {% endif %}

      <a href="{{ routes.cart_url }}" class="header__icon-link header__cart-link">
        {% render 'icon', name: 'cart' %}
        <span class="visually-hidden">
          {{ 'cart.title' | t }}, {{ 'cart.item_count' | t: count: cart.item_count }}
        </span>
        {% if cart.item_count > 0 %}
          <span class="header__cart-count" aria-hidden="true">({{ cart.item_count }})</span>
        {% endif %}
      </a>
    </div>
  </div>
</header>

{% stylesheet %}
  .header {
    position: relative;
    z-index: 10;
    background-color: var(--color-background);
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text);
  }

  /* Homepage only: purely positioning, NO background/scrim of its own.
     Two separate elements each independently computing "span the full
     viewport" is exactly how the previous version got a visible seam —
     the header's own scrim and the hero's overlay were two different
     boxes that didn't land pixel-identical. The darkening behind the nav
     text now lives entirely in the hero's own single overlay layer (see
     sections/hero-kapihan.liquid), which is the same box as the hero's
     image, so there is nothing left for this element to misalign with. */
  .header--transparent {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    background-color: transparent;
    border-bottom-color: transparent;
    color: var(--color-paper);
  }

  .header__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 5.5rem;
  }

  .header__title {
    font-size: var(--font-size-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
  }

  .header__title a {
    color: inherit;
    text-decoration: none;
  }

  /* Mobile nav toggle */
  .header__nav-toggle {
    order: 3;
  }

  .header__nav-toggle-button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    list-style: none;
    cursor: pointer;
    min-width: 2.75rem;
    min-height: 2.75rem;
    margin-inline-end: calc(var(--space-3) * -1);
    padding-inline: var(--space-3);
    color: inherit;
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
  }
  .header__nav-toggle-button::-webkit-details-marker {
    display: none;
  }
  .header__nav-toggle-button svg {
    width: 1.375rem;
  }

  /* The nav is a sibling of <details>, hidden by default and shown via the
     [open] attribute rather than nested inside the disclosure, so it never
     fights the browser's own "hide closed details content" rule. */
  .header__menu {
    display: none;
    flex-direction: column;
    gap: var(--space-1);
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    padding: var(--space-4) var(--page-margin) var(--space-6);
    background-color: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text);
  }
  .header__nav-toggle[open] ~ .header__menu {
    display: flex;
  }

  .header__menu a {
    color: inherit;
    text-decoration: none;
    padding-block: var(--space-3);
    font-size: var(--font-size-md);
  }

  .header__icons {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    order: 2;
  }

  /* 44x44 minimum tap target: the icon glyph stays small and visually
     quiet while the clickable area is generous. */
  .header__icon-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-1);
    min-width: 2.75rem;
    min-height: 2.75rem;
    color: inherit;
  }
  .header__icon-link svg {
    width: 1.375rem;
  }
  .header__cart-link {
    padding-inline-end: var(--space-2);
  }

  .header__cart-count {
    font-size: var(--font-size-xs);
    letter-spacing: var(--tracking-label);
  }

  @media (min-width: 750px) {
    .header__nav-toggle {
      display: none;
    }
    .header__menu {
      display: flex;
      order: 2;
      position: static;
      flex-direction: row;
      align-items: center;
      gap: var(--space-6);
      padding: 0;
      background-color: transparent;
      border-bottom: none;
      color: inherit;
    }
    .header__menu a {
      display: inline-flex;
      align-items: center;
      min-height: 2.75rem;
      margin-block: calc((2.75rem - 1.6em) / -2);
      padding-block: 0;
      font-size: var(--font-size-xs);
      text-transform: uppercase;
      letter-spacing: var(--tracking-label);
      text-underline-offset: 0.2em;
    }
    .header__menu a:hover {
      text-decoration: underline;
    }
    .header__icons {
      order: 3;
      margin-inline-end: calc(var(--space-3) * -1);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "main-menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    }
  ]
}
{% endschema %}
