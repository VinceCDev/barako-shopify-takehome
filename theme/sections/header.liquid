<header class="header{% if template == 'index' %} header--transparent{% endif %}">
  <div class="header__row wrap">
    <p class="header__title">
      <a href="{{ routes.root_url }}">
        {% liquid
          assign logo_url = section.settings.logo | image_url: width: 200
          unless section.settings.logo
            assign logo_url = 'logo.png' | asset_url
          endunless
        %}
        <img src="{{ logo_url }}" alt="{{ shop.name }}" class="header__logo" width="36" height="36">
        <span class="header__title-text">{{ shop.name }}</span>
      </a>
    </p>

    <details class="header__nav-toggle">
      <summary class="header__nav-toggle-button">
        {% render 'icon', name: 'menu' %}
        <span>{{ 'general.menu' | t }}</span>
      </summary>
    </details>

    <nav class="header__menu" aria-label="{{ 'general.menu' | t }}">
      {% for link in section.settings.menu.links %}
        <a
          href="{{ link.url }}"
          class="header__menu-link"
          {% if link.active %}aria-current="page"{% endif %}
        >
          {{ link.title }}
        </a>
      {% endfor %}
    </nav>

    <div class="header__icons">
      {% if shop.customer_accounts_enabled %}
        {% if customer %}
          <details class="header__account-menu">
            <summary class="header__icon-link" aria-label="{{ 'customers.account.title' | t }}">
              {% render 'icon', name: 'account' %}
            </summary>
            <div class="header__account-panel">
              <a href="/pages/profile" class="header__account-link">
                {{ 'customers.account.view_profile' | t }}
              </a>
              <a
                href="{{ routes.account_logout_url }}"
                class="header__account-link"
                data-logout-trigger
                data-confirm-title="{{ 'customers.account.logout_confirm_title' | t }}"
                data-confirm-message="{{ 'customers.account.logout_confirm_message' | t }}"
                data-confirm-action="{{ 'customers.account.logout_confirm_action' | t }}"
                data-cancel-label="{{ 'cart.cancel' | t }}"
              >
                {{ 'customers.account.logout' | t }}
              </a>
            </div>
          </details>
        {% else %}
          <div class="header__auth-links">
            <a href="{{ routes.account_login_url }}" class="header__auth-link">
              {{ 'customers.login.title' | t }}
            </a>
            <a href="{{ routes.account_register_url }}" class="header__auth-link header__auth-link--primary">
              {{ 'customers.register.title' | t }}
            </a>
          </div>
        {% endif %}
      {% endif %}

      <a href="{{ routes.cart_url }}" class="header__icon-link header__cart-link">
        {% render 'icon', name: 'cart' %}
        <span class="visually-hidden">
          {{ 'cart.title' | t }}, {{ 'cart.item_count' | t: count: cart.item_count }}
        </span>
        <span
          class="header__cart-badge"
          data-cart-badge
          data-count="{{ cart.item_count }}"
          aria-hidden="true"
          {% if cart.item_count == 0 %}hidden{% endif %}
        >
          {{ cart.item_count }}
        </span>
      </a>
    </div>
  </div>
</header>

{% stylesheet %}
  .header {
    position: relative;
    z-index: 10;
    background-color: var(--color-background);
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text);
  }

  /* Homepage only: purely positioning, NO background/scrim of its own.
     Two separate elements each independently computing "span the full
     viewport" is exactly how the previous version got a visible seam —
     the header's own scrim and the hero's overlay were two different
     boxes that didn't land pixel-identical. The darkening behind the nav
     text now lives entirely in the hero's own single overlay layer (see
     sections/hero-kapihan.liquid), which is the same box as the hero's
     image, so there is nothing left for this element to misalign with. */
  .header--transparent {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    background-color: transparent;
    border-bottom-color: transparent;
    color: var(--color-paper);
  }

  .header__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 5.5rem;
  }

  .header__title {
    font-size: var(--font-size-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
  }

  .header__title a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: inherit;
    text-decoration: none;
  }

  .header__logo {
    width: 2.25rem;
    height: 2.25rem;
    max-width: none;
    border-radius: 50%;
    object-fit: cover;
  }

  /* Mobile nav toggle */
  .header__nav-toggle {
    order: 3;
  }

  .header__nav-toggle-button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    list-style: none;
    cursor: pointer;
    min-width: 2.75rem;
    min-height: 2.75rem;
    margin-inline-end: calc(var(--space-3) * -1);
    padding-inline: var(--space-3);
    color: inherit;
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
  }
  .header__nav-toggle-button::-webkit-details-marker {
    display: none;
  }
  .header__nav-toggle-button svg {
    width: 1.375rem;
  }

  /* The nav is a sibling of <details>, hidden by default and shown via the
     [open] attribute rather than nested inside the disclosure, so it never
     fights the browser's own "hide closed details content" rule. */
  .header__menu {
    display: none;
    flex-direction: column;
    gap: var(--space-1);
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    padding: var(--space-4) var(--page-margin) var(--space-6);
    background-color: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text);
  }
  .header__nav-toggle[open] ~ .header__menu {
    display: flex;
  }

  .header__menu-link {
    display: inline-flex;
    color: inherit;
    text-decoration: none;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-sm);
    font-size: var(--font-size-md);
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }
  .header__menu-link:hover,
  .header__menu-link[aria-current='page'] {
    background-color: var(--color-primary);
    color: var(--color-on-primary);
  }

  .header__icons {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    order: 2;
  }

  /* Account dropdown: same disclosure pattern as the mobile nav. */
  .header__account-menu {
    position: relative;
  }
  .header__account-menu summary {
    list-style: none;
    cursor: pointer;
  }
  .header__account-menu summary::-webkit-details-marker {
    display: none;
  }
  .header__account-panel {
    position: absolute;
    top: calc(100% + var(--space-2));
    right: 0;
    z-index: 20;
    display: flex;
    flex-direction: column;
    width: 11rem;
    padding: var(--space-2);
    background-color: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.12);
  }
  .header__account-link {
    padding: var(--space-3) var(--space-3);
    border-radius: var(--radius-sm);
    color: var(--color-text);
    text-decoration: none;
    font-size: var(--font-size-sm);
  }
  .header__account-link:hover {
    background-color: var(--color-surface);
  }

  /* Logged out: text buttons in place of the account icon, since there's
     no account to open a dropdown for yet. */
  .header__auth-links {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .header__auth-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: var(--space-3);
    border-radius: var(--radius-sm);
    color: inherit;
    text-decoration: none;
    font-size: var(--font-size-sm);
  }
  .header__auth-link:hover {
    background-color: var(--color-surface);
  }
  .header__auth-link--primary {
    background-color: var(--color-primary);
    color: var(--color-on-primary);
  }
  .header__auth-link--primary:hover {
    background-color: var(--color-primary-hover);
  }

  /* 44x44 minimum tap target: the icon glyph stays small and visually
     quiet while the clickable area is generous. */
  .header__icon-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-1);
    min-width: 2.75rem;
    min-height: 2.75rem;
    color: inherit;
  }
  .header__icon-link svg {
    width: 1.375rem;
  }
  .header__cart-link {
    position: relative;
    padding-inline-end: var(--space-2);
  }

  /* Notification-style badge: a small filled dot pinned to the icon's
     corner, showing only unseen items (see cart-utils.js) rather than the
     running cart total — it clears once the cart page has been visited. */
  .header__cart-badge {
    position: absolute;
    top: 0.25rem;
    right: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.125rem;
    height: 1.125rem;
    padding: 0 var(--space-1);
    border-radius: var(--radius-full);
    background-color: var(--color-primary);
    color: var(--color-on-primary);
    font-size: 0.625rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0;
  }

  @media (min-width: 750px) {
    .header__nav-toggle {
      display: none;
    }
    .header__menu {
      display: flex;
      order: 2;
      position: static;
      flex-direction: row;
      align-items: center;
      gap: var(--space-2);
      padding: 0;
      background-color: transparent;
      border-bottom: none;
      color: inherit;
    }
    .header__menu-link {
      align-items: center;
      min-height: 2.75rem;
      font-size: var(--font-size-xs);
      text-transform: uppercase;
      letter-spacing: var(--tracking-label);
    }
    .header__icons {
      order: 3;
      margin-inline-end: calc(var(--space-3) * -1);
    }
  }
{% endstylesheet %}

{% javascript %}
  document.addEventListener('DOMContentLoaded', function () {
    const logoutLink = document.querySelector('[data-logout-trigger]');
    if (!logoutLink || !window.BarakoConfirm) return;

    logoutLink.addEventListener('click', function (event) {
      event.preventDefault();
      window.BarakoConfirm
        .show({
          title: logoutLink.getAttribute('data-confirm-title'),
          message: logoutLink.getAttribute('data-confirm-message'),
          confirmLabel: logoutLink.getAttribute('data-confirm-action'),
          cancelLabel: logoutLink.getAttribute('data-cancel-label'),
        })
        .then(function (confirmed) {
          if (confirmed) window.location.href = logoutLink.href;
        });
    });
  });
{% endjavascript %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:labels.logo"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
