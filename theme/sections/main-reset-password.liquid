{% comment %}
  Shown when a customer follows the "reset password" link from their
  email — sets a new password via a one-time token Shopify already
  validated before rendering this page.
{% endcomment %}

<div class="account-form-page wrap">
  <div class="account-form-page__inner">
    <h1 class="account-form-page__title">{{ 'customers.reset_password.title' | t }}</h1>

    {% form 'reset_customer_password' %}
      {% if form.errors %}
        <p class="account-form-page__error" role="alert">
          {{ form.errors | default_errors }}
        </p>
      {% endif %}

      <div class="account-form-page__field">
        <label for="ResetPassword">{{ 'customers.activate_account.password' | t }}</label>
        <input type="password" id="ResetPassword" name="customer[password]" autocomplete="new-password" required>
      </div>

      <div class="account-form-page__field">
        <label for="ResetPasswordConfirm">{{ 'customers.activate_account.password_confirm' | t }}</label>
        <input type="password" id="ResetPasswordConfirm" name="customer[password_confirmation]" autocomplete="new-password" required>
      </div>

      <button type="submit" class="button account-form-page__submit">{{ 'customers.activate_account.submit' | t }}</button>
    {% endform %}
  </div>
</div>

{% schema %}
{
  "name": "t:general.main_reset_password",
  "settings": []
}
{% endschema %}
