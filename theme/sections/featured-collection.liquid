{% comment %}
  Displays a grid of products from a chosen collection, used to feature
  the Coffee collection on the homepage.
{% endcomment %}

<section class="featured-collection">
  <div class="featured-collection__header">
    {% if section.settings.heading != blank %}
      <h2 class="featured-collection__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.collection != blank %}
      <a href="{{ section.settings.collection.url }}" class="text-link">
        {{ 'sections.featured_collection.view_all' | t }}
      </a>
    {% endif %}
  </div>

  {% if section.settings.collection != blank %}
    <div class="featured-collection__grid">
      {% for product in section.settings.collection.products limit: section.settings.products_to_show %}
        <a href="{{ product.url }}" class="featured-collection__card">
          {% if product.featured_image %}
            <div class="featured-collection__image-wrap hover-zoom">
              {% render 'image',
                class: 'featured-collection__image',
                image: product.featured_image,
                url: nil,
                width: 600,
                height: 750,
                crop: 'center'
              %}
            </div>
          {% endif %}
          <span class="featured-collection__title">{{ product.title }}</span>
          <span class="featured-collection__price">{{ product.price | money }}</span>
        </a>
      {% endfor %}
    </div>
  {% endif %}
</section>

{% stylesheet %}
  .featured-collection {
    padding-block: var(--section-padding);
  }

  .featured-collection__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--color-border);
  }

  .featured-collection__heading {
    font-size: var(--font-size-2xl);
  }

  .featured-collection__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6) var(--space-5);
  }
  @media (min-width: 48rem) {
    .featured-collection__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .featured-collection__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    color: var(--color-text);
    text-decoration: none;
  }

  .featured-collection__image-wrap {
    aspect-ratio: 4 / 5;
    background-color: var(--color-surface);
  }

  .featured-collection__title {
    font-size: var(--font-size-sm);
  }

  .featured-collection__price {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.featured_collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Shop coffee"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:labels.collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "t:labels.products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "t:general.featured_collection"
    }
  ]
}
{% endschema %}
