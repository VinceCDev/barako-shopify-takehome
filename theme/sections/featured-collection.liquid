{% comment %}
  Displays a grid of products from a chosen collection, used to feature
  the Coffee collection on the homepage.
{% endcomment %}

<section class="featured-collection">
  <div class="featured-collection__header">
    {% if section.settings.heading != blank %}
      <h2 class="featured-collection__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.collection != blank %}
      <a href="{{ section.settings.collection.url }}" class="featured-collection__view-all">
        {{ 'sections.featured_collection.view_all' | t }}
      </a>
    {% endif %}
  </div>

  {% if section.settings.collection != blank %}
    <div class="featured-collection__grid">
      {% for product in section.settings.collection.products limit: section.settings.products_to_show %}
        <a href="{{ product.url }}" class="featured-collection__card">
          {% if product.featured_image %}
            {% render 'image',
              class: 'featured-collection__image',
              image: product.featured_image,
              url: nil,
              width: 480,
              height: 480,
              crop: 'center'
            %}
          {% endif %}
          <span class="featured-collection__title">{{ product.title }}</span>
          <span class="featured-collection__price">{{ product.price | money }}</span>
        </a>
      {% endfor %}
    </div>
  {% endif %}
</section>

{% stylesheet %}
  .featured-collection {
    padding-block: var(--space-8);
  }

  .featured-collection__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .featured-collection__heading {
    font-family: var(--font-heading--family);
    font-size: var(--font-size-2xl);
  }

  .featured-collection__view-all {
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .featured-collection__view-all:hover {
    color: var(--color-primary-hover);
  }

  .featured-collection__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    gap: var(--space-6);
  }

  .featured-collection__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    color: var(--color-text);
    text-decoration: none;
  }

  .featured-collection__image {
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-md);
  }

  .featured-collection__title {
    font-size: var(--font-size-sm);
    font-weight: 600;
  }
  .featured-collection__card:hover .featured-collection__title {
    color: var(--color-primary);
  }

  .featured-collection__price {
    font-size: var(--font-size-sm);
    color: color-mix(in srgb, var(--color-text) 75%, transparent);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.featured_collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Shop coffee"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:labels.collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "t:labels.products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 6
    }
  ],
  "presets": [
    {
      "name": "t:general.featured_collection"
    }
  ]
}
{% endschema %}
