{% comment %}
  Step-by-step brewing guide. Steps are section-local blocks, rendered as
  a numbered list.
{% endcomment %}

<section class="brew-guide" id="brew-guide">
  <div class="brew-guide__header">
    {% if section.settings.heading != blank %}
      <h2 class="brew-guide__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.method_name != blank %}
      <p class="brew-guide__method">{{ section.settings.method_name }}</p>
    {% endif %}

    {% if section.settings.intro != blank %}
      <div class="brew-guide__intro">{{ section.settings.intro }}</div>
    {% endif %}
  </div>

  {% if section.blocks.size > 0 %}
    <ol class="brew-guide__steps">
      {% for block in section.blocks %}
        <li class="brew-guide__step" {{ block.shopify_attributes }}>
          <div class="brew-guide__step-number" aria-hidden="true">{{ forloop.index }}</div>

          <div class="brew-guide__step-body">
            <div class="brew-guide__step-heading">
              {% if block.settings.title != blank %}
                <h3 class="brew-guide__step-title">{{ block.settings.title }}</h3>
              {% endif %}
              {% if block.settings.time != blank %}
                <span class="brew-guide__step-time">{{ block.settings.time }}</span>
              {% endif %}
            </div>

            {% if block.settings.description != blank %}
              <div class="brew-guide__step-description">{{ block.settings.description }}</div>
            {% endif %}

            {% if block.settings.image %}
              {% render 'image', class: 'brew-guide__step-image', image: block.settings.image, width: 480 %}
            {% endif %}
          </div>
        </li>
      {% endfor %}
    </ol>
  {% endif %}
</section>

{% stylesheet %}
  .brew-guide {
    padding-block: var(--space-8);
  }

  .brew-guide__header {
    max-width: 45rem;
    margin-bottom: var(--space-6);
  }

  .brew-guide__heading {
    font-family: var(--font-heading--family);
    font-size: var(--font-size-2xl);
  }

  .brew-guide__method {
    margin-top: var(--space-2);
    font-size: var(--font-size-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-primary);
  }

  .brew-guide__intro {
    margin-top: var(--space-3);
    color: color-mix(in srgb, var(--color-text) 85%, transparent);
  }

  .brew-guide__steps {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    max-width: 42rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .brew-guide__step {
    display: flex;
    gap: var(--space-4);
  }

  .brew-guide__step-number {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-full);
    background-color: var(--color-primary);
    color: var(--color-on-primary);
    font-family: var(--font-heading--family);
    font-size: var(--font-size-md);
    font-weight: 700;
  }

  .brew-guide__step-body {
    flex: 1 1 auto;
  }

  .brew-guide__step-heading {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .brew-guide__step-title {
    font-family: var(--font-heading--family);
    font-size: var(--font-size-lg);
  }

  .brew-guide__step-time {
    padding: 0.15rem var(--space-2);
    border-radius: var(--radius-full);
    background-color: var(--color-surface);
    color: var(--color-primary);
    font-size: var(--font-size-xs);
    font-weight: 600;
  }

  .brew-guide__step-description {
    margin-top: var(--space-2);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-base);
  }

  .brew-guide__step-image {
    margin-top: var(--space-3);
    max-width: 20rem;
    border-radius: var(--radius-md);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.brew_guide",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "How to brew"
    },
    {
      "type": "text",
      "id": "method_name",
      "label": "t:labels.method_name",
      "default": "Pour Over"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "t:labels.intro_text"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "t:general.step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:labels.step_title"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "t:labels.step_description"
        },
        {
          "type": "text",
          "id": "time",
          "label": "t:labels.step_time",
          "info": "t:labels.step_time_info"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:labels.image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.brew_guide"
    }
  ]
}
{% endschema %}
