{% comment %}
  Step-by-step brewing guide. Steps are section-local blocks, laid out as
  a two-column editorial list: a large quiet numeral, then the content.
{% endcomment %}

<section class="brew-guide" id="brew-guide">
  <div class="brew-guide__header">
    {% if section.settings.heading != blank %}
      <h2 class="brew-guide__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.method_name != blank %}
      <p class="brew-guide__method">{{ section.settings.method_name }}</p>
    {% endif %}

    {% if section.settings.intro != blank %}
      <div class="brew-guide__intro">{{ section.settings.intro }}</div>
    {% endif %}
  </div>

  {% if section.blocks.size > 0 %}
    <ol class="brew-guide__steps">
      {% for block in section.blocks %}
        {% assign step_number = forloop.index | prepend: '00' | slice: -2, 2 %}
        <li class="brew-guide__step" {{ block.shopify_attributes }}>
          <div class="brew-guide__step-number" aria-hidden="true">{{ step_number }}</div>

          <div class="brew-guide__step-body">
            <div class="brew-guide__step-heading">
              {% if block.settings.title != blank %}
                <h3 class="brew-guide__step-title">{{ block.settings.title }}</h3>
              {% endif %}
              {% if block.settings.time != blank %}
                <span class="brew-guide__step-time">{{ block.settings.time }}</span>
              {% endif %}
            </div>

            {% if block.settings.description != blank %}
              <div class="brew-guide__step-description">{{ block.settings.description }}</div>
            {% endif %}
          </div>

          <div class="brew-guide__step-media">
            {% if block.settings.image %}
              {{ block.settings.image | image_url: width: 700 | image_tag: class: 'brew-guide__step-image', loading: 'lazy' }}
            {% else %}
              {% comment %}
                No merchant image picked yet: fall back to a bundled photo
                for this step's position (assets/brew-step-<n>.jpg).
              {% endcomment %}
              {% assign fallback_filename = 'brew-step-' | append: forloop.index | append: '.jpg' %}
              <img
                src="{{ fallback_filename | asset_url }}"
                alt=""
                width="900"
                height="600"
                class="brew-guide__step-image"
                loading="lazy"
              >
            {% endif %}
          </div>
        </li>
      {% endfor %}
    </ol>
  {% endif %}
</section>

{% stylesheet %}
  .brew-guide {
    padding-block: var(--section-padding);
  }

  .brew-guide__header {
    max-width: 40rem;
    margin-bottom: var(--space-9);
  }

  .brew-guide__heading {
    font-size: var(--font-size-2xl);
  }

  .brew-guide__method {
    margin-top: var(--space-3);
    font-size: var(--font-size-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--color-text-muted);
  }

  .brew-guide__intro {
    margin-top: var(--space-4);
    font-size: var(--font-size-md);
    color: var(--color-text-muted);
  }

  .brew-guide__steps {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 48rem;
  }
  @media (min-width: 48rem) {
    .brew-guide__steps {
      max-width: none;
    }
  }

  .brew-guide__step {
    display: grid;
    grid-template-columns: 4rem 1fr;
    gap: var(--space-6);
    padding-block: var(--space-7);
    border-top: 1px solid var(--color-border);
  }
  /* The image stacks full-width below the text on mobile. */
  .brew-guide__step-media {
    grid-column: 1 / -1;
    margin-top: var(--space-3);
  }
  @media (min-width: 48rem) {
    .brew-guide__step {
      grid-template-columns: 4rem 1fr 22rem;
      align-items: center;
    }
    .brew-guide__step-media {
      grid-column: 3;
      grid-row: 1;
      margin-top: 0;
    }
  }
  .brew-guide__step:first-child {
    border-top: none;
    padding-top: 0;
  }

  .brew-guide__step-number {
    font-size: var(--font-size-2xl);
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
    line-height: 1;
    color: var(--color-text-muted);
  }

  .brew-guide__step-heading {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .brew-guide__step-title {
    font-size: var(--font-size-lg);
  }

  .brew-guide__step-time {
    font-size: var(--font-size-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--color-text-muted);
  }

  .brew-guide__step-description {
    margin-top: var(--space-3);
    max-width: 40ch;
    font-size: var(--font-size-md);
  }

  .brew-guide__step-image {
    width: 100%;
    max-width: 22rem;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.brew_guide",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "How to brew"
    },
    {
      "type": "text",
      "id": "method_name",
      "label": "t:labels.method_name",
      "default": "Pour Over"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "t:labels.intro_text"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "t:general.step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:labels.step_title"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "t:labels.step_description"
        },
        {
          "type": "text",
          "id": "time",
          "label": "t:labels.step_time",
          "info": "t:labels.step_time_info"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:labels.image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.brew_guide"
    }
  ]
}
{% endschema %}
