{% comment %}
  Full-bleed homepage hero. Uses the merchant's image_picker image when
  set; otherwise falls back to a bundled default photo
  (assets/hero-background.jpg) so the hero never looks unfinished. Only
  falls all the way back to a solid accent color if that asset is missing.
{% endcomment %}

<section
  class="hero-kapihan full-bleed"
  style="
    --hero-overlay-color: {{ section.settings.overlay_color }};
    --hero-overlay-strength: {{ section.settings.overlay_strength }}%;
  "
>
  {% liquid
    assign fallback_image_url = 'hero-background.jpg' | asset_url
  %}
  <div class="hero-kapihan__media">
    {% if section.settings.background_image %}
      {% liquid
        assign focal_point = section.settings.background_image.presentation.focal_point | default: '50% 50%'
        assign hero_image_style = 'object-position: ' | append: focal_point
        assign hero_image = section.settings.background_image | image_url: width: 2400 | image_tag: class: 'hero-kapihan__image', loading: 'eager', fetchpriority: 'high', sizes: '100vw', widths: '750, 1100, 1500, 2000, 2400', style: hero_image_style
      %}
      {{ hero_image }}
      <div class="hero-kapihan__overlay"></div>
    {% else %}
      <img
        src="{{ fallback_image_url }}"
        alt=""
        width="2560"
        height="1704"
        class="hero-kapihan__image"
        loading="eager"
        fetchpriority="high"
      >
      <div class="hero-kapihan__overlay"></div>
    {% endif %}
  </div>

  <div class="hero-kapihan__inner wrap">
    {% if section.settings.eyebrow != blank %}
      <p class="hero-kapihan__eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h1 class="hero-kapihan__heading">{{ section.settings.heading }}</h1>
    {% endif %}

    {% if section.settings.subheading != blank %}
      <div class="hero-kapihan__subheading">{{ section.settings.subheading }}</div>
    {% endif %}

    {% if section.settings.primary_button_label != blank or section.settings.secondary_button_label != blank %}
      <div class="hero-kapihan__actions">
        {% if section.settings.primary_button_label != blank %}
          <a href="{{ section.settings.primary_button_link | default: '#' }}" class="button">
            {{ section.settings.primary_button_label }}
          </a>
        {% endif %}
        {% if section.settings.secondary_button_label != blank %}
          <a href="{{ section.settings.secondary_button_link | default: '#' }}" class="text-link">
            {{ section.settings.secondary_button_label }}
          </a>
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .hero-kapihan {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 80vh;
    color: var(--color-paper);
  }
  @media (min-width: 750px) {
    .hero-kapihan {
      min-height: 100vh;
    }
  }

  .hero-kapihan__media {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 0;
    background-color: var(--color-primary);
  }

  .hero-kapihan__image {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }

  /* The ONE overlay layer for the whole hero — this is also where the
     header's scrim lives when the header sits transparent on top of this
     section (the header itself has no background of its own; see
     sections/header.liquid). Keeping every gradient on this single box,
     the same box the image itself fills, is what guarantees they all
     cover identically edge to edge: there is no second element anywhere
     independently computing "full viewport width" that could land even a
     pixel out of alignment with this one.

     Four stacked layers:
     1. A top band, sized in rem (not %) so it stays ~11rem regardless of
        the hero's own height — this is what keeps the header's nav text
        readable.
     2. A diagonal wash for the editorial "fade into the photo" look,
        strongest bottom-left.
     3. A flat full-width band at the bottom that guarantees the whole
        text block (eyebrow through buttons) gets the SAME strong,
        uniform coverage regardless of exactly where each line falls (the
        diagonal alone let the topmost line — the eyebrow — land in a
        weaker part of the falloff).
     4. A light wash everywhere else so no part of the photo is ever left
        fully uncovered. */
  .hero-kapihan__overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to bottom,
        color-mix(in srgb, var(--hero-overlay-color) var(--hero-overlay-strength), transparent) 0,
        transparent 11rem
      ),
      linear-gradient(
        to top right,
        color-mix(in srgb, var(--hero-overlay-color) var(--hero-overlay-strength), transparent) 0%,
        transparent 70%
      ),
      linear-gradient(
        to top,
        color-mix(in srgb, var(--hero-overlay-color) var(--hero-overlay-strength), transparent) 0%,
        color-mix(in srgb, var(--hero-overlay-color) var(--hero-overlay-strength), transparent) 42%,
        transparent 78%
      ),
      color-mix(in srgb, var(--hero-overlay-color) 25%, transparent);
  }

  .hero-kapihan__inner {
    position: relative;
    z-index: 1;
    padding-block: var(--space-8) var(--space-9);
  }

  .hero-kapihan__eyebrow {
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    font-size: var(--font-size-xs);
    font-weight: 600;
    opacity: 0.72;
    margin-bottom: var(--space-4);
  }

  .hero-kapihan__heading {
    font-size: clamp(2.5rem, 2.2rem + 3vw, 5rem);
    max-width: 14ch;
  }

  .hero-kapihan__subheading {
    margin-top: var(--space-5);
    max-width: 40ch;
    font-size: var(--font-size-md);
  }

  .hero-kapihan__actions {
    margin-top: var(--space-7);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-6);
  }

  /* The hero sits on a dark image; invert the button to read against it,
     while keeping it a solid ink/paper pairing everywhere else on the page. */
  .hero-kapihan .button {
    background-color: var(--color-paper);
    border-color: var(--color-paper);
    color: var(--color-ink);
  }
  .hero-kapihan .button:hover {
    background-color: transparent;
    color: var(--color-paper);
  }
  .hero-kapihan .text-link {
    color: var(--color-paper);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:labels.background_image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Barako &amp; Co."
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "t:labels.subheading"
    },
    {
      "type": "text",
      "id": "primary_button_label",
      "label": "t:labels.primary_button_label"
    },
    {
      "type": "url",
      "id": "primary_button_link",
      "label": "t:labels.primary_button_link"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "t:labels.secondary_button_label"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "t:labels.secondary_button_link"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "t:labels.overlay_color",
      "default": "#1B1612"
    },
    {
      "type": "range",
      "id": "overlay_strength",
      "label": "t:labels.overlay_strength",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 65
    }
  ],
  "presets": [
    {
      "name": "t:general.hero"
    }
  ]
}
{% endschema %}
