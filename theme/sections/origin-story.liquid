{% comment %}
  "Where our coffee grows" — an editorial row per growing region, image
  and text alternating sides on desktop. Always image-then-text in source
  order so the stacked mobile layout reads the same regardless of side.
  When a block links to a product, altitude and tasting notes are pulled
  from that product's own metafields rather than duplicated as block
  settings; variety and process have no metafield equivalent, so they
  always come from the block.
{% endcomment %}

<section class="origin-story">
  {% if section.settings.eyebrow != blank %}
    <p class="origin-story__eyebrow">{{ section.settings.eyebrow }}</p>
  {% endif %}

  {% if section.settings.heading != blank %}
    <h2 class="origin-story__heading">{{ section.settings.heading }}</h2>
  {% endif %}

  {% if section.settings.intro != blank %}
    <div class="origin-story__intro">{{ section.settings.intro }}</div>
  {% endif %}

  {% if section.blocks.size > 0 %}
    <div class="origin-story__list">
      {% for block in section.blocks %}
        {% liquid
          assign is_reverse_row = forloop.index0 | modulo: 2
          assign linked_product = block.settings.product
          assign display_variety = block.settings.variety
          assign display_process = block.settings.process
          if linked_product != blank
            assign display_altitude = linked_product.metafields.custom.altitude.value | default: block.settings.altitude
            assign display_tasting_notes = linked_product.metafields.custom.flavor_notes.value | default: block.settings.tasting_notes
          else
            assign display_altitude = block.settings.altitude
            assign display_tasting_notes = block.settings.tasting_notes
          endif
        %}
        <article
          class="origin-row grid-12{% if is_reverse_row == 1 %} origin-row--reverse{% endif %}"
          {{ block.shopify_attributes }}
        >
          <div class="origin-row__media">
            {% if block.settings.image %}
              {% liquid
                assign focal_point = block.settings.image.presentation.focal_point | default: '50% 50%'
                assign origin_image_style = 'object-position: ' | append: focal_point
                assign origin_image = block.settings.image | image_url: width: 1600 | image_tag: class: 'origin-row__image', loading: 'lazy', sizes: '(min-width: 64rem) 42vw, 100vw', widths: '450, 700, 900, 1200, 1600', style: origin_image_style
              %}
              <div class="hover-zoom">{{ origin_image }}</div>
            {% else %}
              {% comment %}
                No merchant image picked yet: fall back to a bundled photo
                named to match the region (assets/origin-<handle>.jpg).
              {% endcomment %}
              {% liquid
                assign region_handle = block.settings.region_name | handleize
                assign fallback_filename = 'origin-' | append: region_handle | append: '.jpg'
              %}
              {% if region_handle != blank %}
                <div class="hover-zoom">
                  <img
                    src="{{ fallback_filename | asset_url }}"
                    alt=""
                    width="800"
                    height="1000"
                    class="origin-row__image"
                    loading="lazy"
                  >
                </div>
              {% endif %}
            {% endif %}
          </div>

          <div class="origin-row__content">
            {% if block.settings.region_name != blank %}
              <h3 class="origin-row__title">{{ block.settings.region_name }}</h3>
            {% endif %}

            {% if block.settings.province != blank or display_altitude != blank %}
              <p class="origin-row__meta">
                {{ block.settings.province }}
                {%- if display_altitude != blank %} &middot; {{ display_altitude }} M{% endif -%}
              </p>
            {% endif %}

            {% if block.settings.story != blank %}
              <div class="origin-row__story">{{ block.settings.story }}</div>
            {% endif %}

            {% if display_altitude != blank or display_variety != blank or display_process != blank or display_tasting_notes != blank %}
              <dl class="origin-row__facts">
                {% if display_altitude != blank %}
                  <div class="origin-row__fact">
                    <dt>{{ 'sections.origin_story.altitude' | t }}</dt>
                    <dd>{{ display_altitude }} m</dd>
                  </div>
                {% endif %}
                {% if display_variety != blank %}
                  <div class="origin-row__fact">
                    <dt>{{ 'sections.origin_story.variety' | t }}</dt>
                    <dd>{{ display_variety }}</dd>
                  </div>
                {% endif %}
                {% if display_process != blank %}
                  <div class="origin-row__fact">
                    <dt>{{ 'sections.origin_story.process' | t }}</dt>
                    <dd>{{ display_process }}</dd>
                  </div>
                {% endif %}
                {% if display_tasting_notes != blank %}
                  <div class="origin-row__fact">
                    <dt>{{ 'sections.origin_story.tasting_notes' | t }}</dt>
                    <dd>{{ display_tasting_notes }}</dd>
                  </div>
                {% endif %}
              </dl>
            {% endif %}

            {% if linked_product != blank %}
              <a href="{{ linked_product.url }}" class="text-link origin-row__link">
                {{ 'sections.origin_story.shop_this_origin' | t }}
                {% render 'icon', name: 'arrow-right' %}
              </a>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  {% endif %}
</section>

{% stylesheet %}
  .origin-story {
    padding-block: var(--section-padding);
  }

  .origin-story__eyebrow {
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    font-size: var(--font-size-xs);
    font-weight: 600;
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }

  .origin-story__heading {
    font-size: var(--font-size-2xl);
    margin-bottom: var(--space-3);
  }

  .origin-story__intro {
    max-width: 55ch;
    margin-bottom: var(--space-9);
    font-size: var(--font-size-md);
    color: var(--color-text-muted);
  }

  .origin-story__list {
    display: flex;
    flex-direction: column;
  }

  /* One consistent gap unit between rows (padding, not a stacked
     padding+gap combo) so the rhythm reads evenly down the page. */
  .origin-row {
    padding-block: var(--space-8);
    border-top: 1px solid var(--color-border);
  }
  .origin-row:first-child {
    border-top: none;
    padding-top: 0;
  }

  .origin-row__media {
    grid-column: span 12;
  }

  .origin-row__image {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .origin-row__content {
    grid-column: span 12;
    padding-top: var(--space-5);
  }

  .origin-row__title {
    font-size: var(--font-size-xl);
  }

  .origin-row__meta {
    margin-top: var(--space-2);
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--color-text-muted);
  }

  .origin-row__story {
    margin-top: var(--space-5);
    max-width: 42ch;
    font-size: var(--font-size-md);
  }
  .origin-row__story p + p {
    margin-top: var(--space-3);
  }

  /* Definition list of quick specs. Two columns once there's room, so
     four facts read as a compact grid rather than a long single column. */
  .origin-row__facts {
    margin: var(--space-6) 0 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4) var(--space-5);
    max-width: 30rem;
  }
  .origin-row__fact dt {
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--color-text-muted);
  }
  .origin-row__fact dd {
    margin: var(--space-1) 0 0;
    font-size: var(--font-size-base);
  }

  .origin-row__link {
    margin-top: var(--space-6);
    gap: var(--space-2);
  }
  .origin-row__link svg {
    width: 1rem;
    transition: transform var(--transition-fast);
  }
  .origin-row__link:hover svg {
    transform: translateX(0.2em);
  }

  @media (min-width: 64rem) {
    .origin-row {
      align-items: start;
    }
    /* Image ~5/12, a full empty column as the gutter, text ~6/12. */
    .origin-row__media {
      grid-column: 1 / span 5;
      order: 1;
    }
    .origin-row__image {
      max-height: 35rem;
    }
    .origin-row__content {
      grid-column: 7 / span 6;
      order: 2;
      padding-top: 0;
    }
    .origin-row--reverse .origin-row__media {
      grid-column: 8 / span 5;
      order: 2;
    }
    .origin-row--reverse .origin-row__content {
      grid-column: 1 / span 6;
      grid-row: 1;
      order: 1;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.origin_story",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Where our coffee grows"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "t:labels.intro_text"
    }
  ],
  "blocks": [
    {
      "type": "origin",
      "name": "t:general.origin",
      "settings": [
        {
          "type": "text",
          "id": "region_name",
          "label": "t:labels.region_name"
        },
        {
          "type": "text",
          "id": "province",
          "label": "t:labels.province"
        },
        {
          "type": "richtext",
          "id": "story",
          "label": "t:labels.story"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:labels.image"
        },
        {
          "type": "product",
          "id": "product",
          "label": "t:labels.linked_product",
          "info": "t:labels.linked_product_info"
        },
        {
          "type": "header",
          "content": "t:labels.origin_facts_header",
          "info": "t:labels.origin_facts_info"
        },
        {
          "type": "range",
          "id": "altitude",
          "label": "t:labels.altitude",
          "min": 0,
          "max": 2500,
          "step": 50,
          "unit": "m",
          "default": 500
        },
        {
          "type": "text",
          "id": "variety",
          "label": "t:labels.variety"
        },
        {
          "type": "text",
          "id": "process",
          "label": "t:labels.process"
        },
        {
          "type": "text",
          "id": "tasting_notes",
          "label": "t:labels.tasting_notes"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.origin_story"
    }
  ]
}
{% endschema %}
