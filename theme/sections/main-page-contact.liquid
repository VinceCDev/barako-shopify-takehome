{% comment %}
  Contact page: up to 4 stacked contact-detail cards on the left (each a
  block, so a merchant can edit/reorder/remove them), a contact form
  (Shopify's built-in 'contact' form type, emails the store owner) on the
  right.
{% endcomment %}

<div class="contact-page wrap">
  <h1 class="contact-page__title">{{ page.title }}</h1>
  {% if page.content != blank %}
    <div class="contact-page__intro">{{ page.content }}</div>
  {% else %}
    <p class="contact-page__intro">{{ 'contact.intro' | t }}</p>
  {% endif %}

  <div class="contact-page__layout">
    {% if section.blocks.size > 0 %}
      <div class="contact-page__info">
        {% for block in section.blocks %}
          <div class="contact-info-card" {{ block.shopify_attributes }}>
            {% if block.settings.icon != 'none' %}
              <div class="contact-info-card__icon">{% render 'icon', name: block.settings.icon %}</div>
            {% endif %}
            <div>
              {% if block.settings.label != blank %}
                <p class="contact-info-card__label">{{ block.settings.label }}</p>
              {% endif %}
              {% if block.settings.value != blank %}
                {% liquid
                  assign clean_value = block.settings.value | strip_html | strip
                %}
                {% if block.settings.icon == 'phone' %}
                  <a class="contact-info-card__value contact-info-card__value--link" href="tel:{{ clean_value | remove: ' ' }}">
                    {{ clean_value }}
                  </a>
                {% elsif block.settings.icon == 'mail' %}
                  <a class="contact-info-card__value contact-info-card__value--link" href="mailto:{{ clean_value }}">
                    {{ clean_value }}
                  </a>
                {% else %}
                  <div class="contact-info-card__value">{{ block.settings.value }}</div>
                {% endif %}
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}

    <div class="contact-page__form-wrap">
      {% form 'contact' %}
        <h2 class="contact-page__form-title">{{ 'contact.form_title' | t }}</h2>
        {% if form.posted_successfully? %}
          <p class="account-form-page__success" role="status">{{ 'contact.success' | t }}</p>
        {% endif %}
        {% if form.errors %}
          <p class="account-form-page__error" role="alert">{{ form.errors | default_errors }}</p>
        {% endif %}

        <div class="account-form-page__field">
          <label for="ContactName">{{ 'contact.name' | t }}</label>
          <input type="text" id="ContactName" name="contact[name]" value="{{ form.name }}" autocomplete="name">
        </div>

        <div class="account-form-page__field">
          <label for="ContactEmail">{{ 'contact.email' | t }}</label>
          <input type="email" id="ContactEmail" name="contact[email]" value="{{ form.email }}" autocomplete="email" required>
        </div>

        <div class="account-form-page__field">
          <label for="ContactPhone">{{ 'contact.phone' | t }}</label>
          <input type="tel" id="ContactPhone" name="contact[phone]" value="{{ form.phone }}" autocomplete="tel">
        </div>

        <div class="account-form-page__field">
          <label for="ContactMessage">{{ 'contact.message' | t }}</label>
          <textarea id="ContactMessage" name="contact[body]" rows="5" required>{{ form.body }}</textarea>
        </div>

        <button type="submit" class="button">{{ 'contact.submit' | t }}</button>
      {% endform %}
    </div>
  </div>
</div>

{% stylesheet %}
  .contact-page {
    padding-block: var(--section-padding);
  }
  .contact-page__title {
    font-size: var(--font-size-2xl);
  }
  .contact-page__intro {
    margin-top: var(--space-2);
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .contact-page__form-title {
    margin-bottom: var(--space-5);
    font-size: var(--font-size-lg);
  }

  .contact-page__layout {
    margin-top: var(--space-8);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }
  @media (min-width: 64rem) {
    .contact-page__layout {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }

  .contact-page__info {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .contact-page__form-wrap {
    padding: var(--space-5);
    background-color: var(--color-surface);
    border-radius: var(--radius-md);
  }

  .contact-info-card {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-5);
    background-color: var(--color-surface);
    border-radius: var(--radius-md);
  }
  .contact-info-card__icon {
    flex: 0 0 auto;
    display: flex;
    color: var(--color-primary);
  }
  .contact-info-card__icon svg {
    width: 1.5rem;
  }
  .contact-info-card__label {
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--color-text-muted);
  }
  .contact-info-card__value {
    margin-top: var(--space-1);
    font-size: var(--font-size-sm);
  }
  .contact-info-card__value--link {
    display: block;
    color: var(--color-text);
    text-decoration: none;
  }
  .contact-info-card__value--link:hover {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .contact-info-card__value p + p {
    margin-top: var(--space-1);
  }

  .account-form-page__field textarea {
    width: 100%;
    resize: vertical;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.main_page_contact",
  "blocks": [
    {
      "type": "info",
      "name": "t:general.contact_info",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:labels.icon",
          "default": "map-pin",
          "options": [
            { "value": "map-pin", "label": "t:options.icon.map_pin" },
            { "value": "phone", "label": "t:options.icon.phone" },
            { "value": "mail", "label": "t:options.icon.mail" },
            { "value": "clock", "label": "t:options.icon.clock" },
            { "value": "none", "label": "t:options.icon.none" }
          ]
        },
        {
          "type": "text",
          "id": "label",
          "label": "t:labels.label"
        },
        {
          "type": "richtext",
          "id": "value",
          "label": "t:labels.value"
        }
      ]
    }
  ],
