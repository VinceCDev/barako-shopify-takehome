{% comment %}
  Product-page section that reads coffee-specific metafields. Renders
  nothing at all when a product has no coffee metafields (e.g. gear).
{% endcomment %}

{% liquid
  assign roast_level = product.metafields.custom.roast_level.value
  assign flavor_notes_raw = product.metafields.custom.flavor_notes.value
  assign origin_region = product.metafields.custom.origin_region.value
  assign altitude = product.metafields.custom.altitude.value
  assign acidity = product.metafields.custom.acidity.value
  assign body_score = product.metafields.custom.body.value
  assign sweetness = product.metafields.custom.sweetness.value

  assign has_flavor_data = false
  if roast_level != blank or acidity != blank or body_score != blank or sweetness != blank
    assign has_flavor_data = true
  endif
%}

{% if has_flavor_data %}
  <section class="flavor-profile">
    {% if section.settings.heading != blank %}
      <h2 class="flavor-profile__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if roast_level != blank or origin_region != blank %}
      <p class="flavor-profile__meta">
        {{ roast_level }} roast
        {%- if origin_region != blank %} &middot; {{ origin_region }}{% endif -%}
        {%- if altitude != blank %} &middot; {{ altitude }} M{% endif -%}
      </p>
    {% endif %}

    {% if flavor_notes_raw != blank %}
      <p class="flavor-profile__notes">{{ flavor_notes_raw }}</p>
    {% endif %}

    <div class="flavor-profile__scales" style="--flavor-scale-color: {{ section.settings.bar_color }};">
      {% if acidity != blank %}
        {% assign acidity_label = 'sections.flavor_profile.acidity' | t %}
        {% render 'flavor-bar', label: acidity_label, value: acidity %}
      {% endif %}
      {% if body_score != blank %}
        {% assign body_label = 'sections.flavor_profile.body' | t %}
        {% render 'flavor-bar', label: body_label, value: body_score %}
      {% endif %}
      {% if sweetness != blank %}
        {% assign sweetness_label = 'sections.flavor_profile.sweetness' | t %}
        {% render 'flavor-bar', label: sweetness_label, value: sweetness %}
      {% endif %}
    </div>
  </section>
{% endif %}

{% stylesheet %}
  .flavor-profile {
    padding-block: var(--section-padding);
  }

  .flavor-profile__heading {
    font-size: var(--font-size-2xl);
    margin-bottom: var(--space-4);
  }

  .flavor-profile__meta {
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
  }

  .flavor-profile__notes {
    font-size: var(--font-size-md);
    font-style: italic;
    max-width: 40ch;
    margin-bottom: var(--space-7);
  }

  .flavor-profile__scales {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: 24rem;
  }

  /* Scales used by snippets/flavor-bar.liquid; scoped here since snippets
     cannot declare their own stylesheet block. */
  .flavor-scale {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
  .flavor-scale__label {
    flex: 0 0 6rem;
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--color-text-muted);
  }
  .flavor-scale__marks {
    display: flex;
    gap: var(--space-2);
  }
  .flavor-scale__mark {
    width: 0.5rem;
    height: 0.5rem;
    border: 1px solid var(--flavor-scale-color, var(--color-primary));
    background-color: transparent;
  }
  .flavor-scale__mark--filled {
    background-color: var(--flavor-scale-color, var(--color-primary));
  }
  .flavor-scale__value {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.flavor_profile",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Flavor profile"
    },
    {
      "type": "color",
      "id": "bar_color",
      "label": "t:labels.bar_color",
      "default": "#4A2C1D"
    }
  ],
  "presets": [
    {
      "name": "t:general.flavor_profile"
    }
  ]
}
{% endschema %}
