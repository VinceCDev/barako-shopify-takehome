{% comment %}
  Collection page: banner, a filter/sort toolbar (native storefront
  filtering, works via plain GET requests without JS, enhanced to
  auto-submit with JS), a responsive product grid, and pagination.
{% endcomment %}

<div class="collection-banner wrap">
  <h1 class="collection-banner__title">{{ collection.title }}</h1>
  {% if collection.description != blank %}
    <div class="collection-banner__description">{{ collection.description }}</div>
  {% endif %}
</div>

{% paginate collection.products by 24 %}
  {% liquid
    # Price gets its own dropdown, separate from the catch-all "Filters"
    # disclosure, so the toolbar reads as distinct Price / Rating / Sort
    # controls rather than one generic bucket.
    assign price_filter = null
    assign other_filters_count = 0
    assign has_active_price_filter = false
    assign has_active_other_filters = false

    for filter in collection.filters
      if filter.type == 'price_range'
        assign price_filter = filter
        if filter.min_value.value != blank or filter.max_value.value != blank
          assign has_active_price_filter = true
        endif
      else
        assign other_filters_count = other_filters_count | plus: 1
        for value in filter.values
          if value.active
            assign has_active_other_filters = true
          endif
        endfor
      endif
    endfor
  %}

  <div class="collection-toolbar wrap">
    <div class="collection-toolbar__start">
      {% render 'search-bar', id: 'CollectionSearch', mode: 'collection' %}
    </div>

    <div class="collection-toolbar__end">
    {% if price_filter %}
      <details class="collection-filters" id="CollectionPriceDrawer">
        <summary class="collection-filters__toggle">
          <span>{{ 'collection.price' | t }}</span>
          {% render 'icon', name: 'chevron-down' %}
        </summary>

        <div class="collection-filters__panel">
          <form id="CollectionPriceForm" method="get" action="{{ collection.url }}">
            {% comment %} Preserve the other filters' active state. {% endcomment %}
            {% for filter in collection.filters %}
              {% unless filter.type == 'price_range' %}
                {% for value in filter.values %}
                  {% if value.active %}
                    <input type="hidden" name="{{ value.param_name }}" value="{{ value.value }}">
                  {% endif %}
                {% endfor %}
              {% endunless %}
            {% endfor %}

            <fieldset class="collection-filter">
              <legend class="collection-filter__legend">{{ price_filter.label }}</legend>
              <div class="collection-filter__price-range">
                <label class="visually-hidden" for="FilterPriceMin">{{ price_filter.min_value.param_name }}</label>
                <input
                  type="number"
                  id="FilterPriceMin"
                  name="{{ price_filter.min_value.param_name }}"
                  placeholder="{{ price_filter.range_min | money_without_currency }}"
                  value="{{ price_filter.min_value.value }}"
                  min="0"
                >
                <span aria-hidden="true">&ndash;</span>
                <label class="visually-hidden" for="FilterPriceMax">{{ price_filter.max_value.param_name }}</label>
                <input
                  type="number"
                  id="FilterPriceMax"
                  name="{{ price_filter.max_value.param_name }}"
                  placeholder="{{ price_filter.range_max | money_without_currency }}"
                  value="{{ price_filter.max_value.value }}"
                  min="0"
                >
              </div>
            </fieldset>

            <div class="collection-filter__actions">
              <button type="submit" class="button" data-filter-submit>
                {{ 'collection.apply_filters' | t }}
              </button>
              {% if has_active_price_filter %}
                <a href="{{ collection.url }}" class="text-link">{{ 'collection.clear_filters' | t }}</a>
              {% endif %}
            </div>
          </form>
        </div>
      </details>
    {% endif %}

    {% if other_filters_count > 0 %}
      <details class="collection-filters" id="CollectionFiltersDrawer">
        <summary class="collection-filters__toggle">
          <span>{{ 'collection.filters' | t }}</span>
          {% render 'icon', name: 'chevron-down' %}
        </summary>

        <div class="collection-filters__panel">
          <form id="CollectionFiltersForm" method="get" action="{{ collection.url }}">
            {% comment %} Preserve the price filter's active state. {% endcomment %}
            {% if price_filter %}
              {% if price_filter.min_value.value != blank %}
                <input type="hidden" name="{{ price_filter.min_value.param_name }}" value="{{ price_filter.min_value.value }}">
              {% endif %}
              {% if price_filter.max_value.value != blank %}
                <input type="hidden" name="{{ price_filter.max_value.param_name }}" value="{{ price_filter.max_value.value }}">
              {% endif %}
            {% endif %}

            {% for filter in collection.filters %}
              {% unless filter.type == 'price_range' %}
                <fieldset class="collection-filter">
                  <legend class="collection-filter__legend">{{ filter.label }}</legend>
                  <div class="collection-filter__options">
                    {% for value in filter.values %}
                      {% assign option_disabled = false %}
                      {% if value.count == 0 and value.active == false %}
                        {% assign option_disabled = true %}
                      {% endif %}
                      <label class="collection-filter__option{% if option_disabled %} collection-filter__option--disabled{% endif %}">
                        <input
                          type="checkbox"
                          name="{{ value.param_name }}"
                          value="{{ value.value }}"
                          {% if value.active %}checked{% endif %}
                          {% if option_disabled %}disabled{% endif %}
                        >
                        <span>{{ value.label }} ({{ value.count }})</span>
                      </label>
                    {% endfor %}
                  </div>
                </fieldset>
              {% endunless %}
            {% endfor %}

            <div class="collection-filter__actions">
              <button type="submit" class="button" data-filter-submit>
                {{ 'collection.apply_filters' | t }}
              </button>
              {% if has_active_other_filters %}
                <a href="{{ collection.url }}" class="text-link">{{ 'collection.clear_filters' | t }}</a>
              {% endif %}
            </div>
          </form>
        </div>
      </details>
    {% endif %}

    {% comment %}
      Client-side, like the search filter — rating isn't a native Shopify
      filter (it's a plain custom metafield, not one exposed via the
      Search & Discovery app), so this just shows/hides the already
      -rendered cards rather than reloading the page.
    {% endcomment %}
    <details class="collection-filters" id="CollectionRatingDrawer">
      <summary class="collection-filters__toggle">
        <span>{{ 'collection.rating_filter' | t }}</span>
        {% render 'icon', name: 'chevron-down' %}
      </summary>

      <div class="collection-filters__panel">
        <fieldset class="collection-filter">
          <legend class="collection-filter__legend">{{ 'collection.rating_filter' | t }}</legend>
          <div class="collection-filter__options" data-rating-filter>
            <label class="collection-filter__option">
              <input type="radio" name="rating_filter_choice" value="" data-rating-filter-input checked>
              <span>{{ 'collection.rating_any' | t }}</span>
            </label>
            {% for threshold in (1..4) reversed %}
              <label class="collection-filter__option">
                <input type="radio" name="rating_filter_choice" value="{{ threshold }}" data-rating-filter-input>
                <span>{{ 'collection.rating_and_up' | t: rating: threshold }}</span>
              </label>
            {% endfor %}
          </div>
        </fieldset>
      </div>
    </details>
    </div>
  </div>

  {% if collection.products.size > 0 %}
    <div class="collection-grid wrap">
      {% for product in collection.products %}
        {% render 'product-card',
          product: product,
          image_sizes: '(min-width: 64rem) 25vw, (min-width: 48rem) 33vw, 50vw'
        %}
      {% endfor %}
    </div>

    {% if paginate.pages > 1 %}
      <nav class="collection-pagination wrap" aria-label="{{ 'general.pagination' | t }}">
        <ul class="collection-pagination__list">
          {% if paginate.previous %}
            <li>
              <a href="{{ paginate.previous.url }}" class="collection-pagination__link" aria-label="{{ 'collection.previous' | t }}">
                {% render 'icon', name: 'chevron-left' %}
              </a>
            </li>
          {% endif %}

          {% for part in paginate.parts %}
            <li>
              {% if part.is_link %}
                <a href="{{ part.url }}" class="collection-pagination__link">{{ part.title }}</a>
              {% else %}
                <span class="collection-pagination__link collection-pagination__link--current" aria-current="page">
                  {{ part.title }}
                </span>
              {% endif %}
            </li>
          {% endfor %}

          {% if paginate.next %}
            <li>
              <a href="{{ paginate.next.url }}" class="collection-pagination__link" aria-label="{{ 'collection.next' | t }}">
                {% render 'icon', name: 'chevron-right' %}
              </a>
            </li>
          {% endif %}
        </ul>
      </nav>
    {% endif %}
  {% else %}
    <div class="collection-empty wrap">
      <p class="collection-empty__title">{{ 'collection.no_products' | t }}</p>
      <p class="collection-empty__body">{{ 'collection.no_products_body' | t }}</p>
      <a href="{{ collection.url }}" class="button">{{ 'collection.view_all' | t }}</a>
    </div>
  {% endif %}
{% endpaginate %}

{% stylesheet %}
  .collection-banner {
    padding-block: var(--section-padding) var(--space-8);
  }
  .collection-banner__title {
    font-size: var(--font-size-2xl);
  }
  .collection-banner__description {
    margin-top: var(--space-2);
    max-width: 55ch;
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .collection-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
    padding-bottom: var(--space-6);
    margin-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-border);
  }
  /* Search stays on the left; Price/Filters/Rating and Sort group
     together at the right end of the toolbar. */
  .collection-toolbar__start {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
  }
  .collection-toolbar__end {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }

  .collection-toolbar__start .search-bar {
    flex: 1 1 16rem;
    max-width: 22rem;
  }

  /* Mobile: search gets its own full-width row (a compact search box
     reads as cramped) — the Price/Filters/Rating pills and Sort stay
     compact and wrap as their own row together, matching the pill-style
     dropdown look rather than a stacked list. Comes after the base rules
     above so it wins the cascade at equal specificity, and resets `flex`
     in full — leaving a stale flex-basis (meant for a horizontal row) in
     place would size the item's HEIGHT instead once a parent becomes
     flex-direction: column. */
  @media (max-width: 47.99rem) {
    .collection-toolbar {
      flex-direction: column;
      align-items: stretch;
    }
    .collection-toolbar__start .search-bar {
      flex: none;
      width: 100%;
      max-width: none;
    }
  }

  /* Filters: a <details> disclosure, styled to read as a plain dropdown
     select (rounded box, label, trailing chevron) rather than an
     accordion-style toggle, so Price/Filters/Rating sit next to Sort as
     one visually consistent row of controls. */
  .collection-filters__toggle {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-width: 9rem;
    height: 2.75rem;
    padding-inline: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background-color: var(--color-background);
    cursor: pointer;
    list-style: none;
    font-size: var(--font-size-sm);
  }
  .collection-filters[open] > .collection-filters__toggle {
    border-color: var(--color-primary);
  }
  .collection-filters__toggle::-webkit-details-marker {
    display: none;
  }
  .collection-filters__toggle svg {
    width: 1.125rem;
    flex: 0 0 auto;
    color: var(--color-text-muted);
  }
  .collection-filters__panel {
    display: none;
    position: absolute;
    z-index: 20;
    margin-top: var(--space-2);
    padding: var(--space-5);
    background-color: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.12);
    min-width: 16rem;
  }
  .collection-filters[open] .collection-filters__panel {
    display: block;
  }

  .collection-filter {
    border: 0;
    padding: 0;
    margin: 0 0 var(--space-5);
  }
  .collection-filter__legend {
    font-size: var(--font-size-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }
  .collection-filter__options {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .collection-filter__option {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--font-size-sm);
    min-height: 1.75rem;
  }
  .collection-filter__option--disabled {
    color: var(--color-text-muted);
    opacity: 0.6;
  }
  .collection-filter__price-range {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .collection-filter__price-range input {
    width: 6rem;
  }
  .collection-filter__actions {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    margin-top: var(--space-6);
  }

  /* These submit buttons only matter without JS (auto-submit takes over
     once JS is active) — hiding them via CSS off the .js/.no-js class
     already flipped before first paint avoids the flash a JS-timed
     .hidden = true would otherwise risk. */
  [data-filter-submit] {
    display: none;
  }
  .no-js [data-filter-submit] {
    display: inline-flex;
  }

  /* Anchors the popover .collection-filters__panel to its own toggle,
     at every width — the dropdown-pill look applies consistently rather
     than switching to a permanently-expanded inline bar at desktop. */
  .collection-filters {
    position: relative;
  }
  .collection-toolbar {
    align-items: center;
  }
  .collection-toolbar__start {
    align-items: center;
  }

  .collection-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6) var(--space-5);
    padding-bottom: var(--section-padding);
  }
  @media (min-width: 48rem) {
    .collection-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (min-width: 64rem) {
    .collection-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .collection-empty {
    padding-bottom: var(--section-padding);
    text-align: center;
    max-width: 32rem;
    margin-inline: auto;
  }
  .collection-empty__title {
    font-size: var(--font-size-xl);
  }
  .collection-empty__body {
    margin-top: var(--space-3);
    color: var(--color-text-muted);
  }
  .collection-empty .button {
    margin-top: var(--space-6);
  }
{% endstylesheet %}

{% javascript %}
  document.addEventListener('DOMContentLoaded', function () {
    var filterForm = document.getElementById('CollectionFiltersForm');
    if (filterForm) {
      var checkboxes = filterForm.querySelectorAll('input[type="checkbox"]');
      checkboxes.forEach(function (checkbox) {
        checkbox.addEventListener('change', function () {
          filterForm.requestSubmit();
        });
      });
    }

    /*
     * DOCU: Wires the rating filter radios to show/hide already-rendered
     * product cards client-side — rating isn't a native Shopify filter,
     * so this is a plain-JS complement to the real (server-driven)
     * filters above, using a class so it composes with the search
     * filter's own hiding instead of overwriting it.
     *
     * Last Updated: 2026-09-28
     * Author: Vince Allen
     * Last Updated By: Vince Allen
     */
    const ratingInputs = document.querySelectorAll('[data-rating-filter-input]');
    if (ratingInputs.length > 0) {
      const applyRatingFilter = () => {
        const checked = document.querySelector('[data-rating-filter-input]:checked');
        const threshold = checked ? parseFloat(checked.value) || 0 : 0;

        document.querySelectorAll('.product-card[data-product-rating]').forEach((card) => {
          const rating = parseFloat(card.getAttribute('data-product-rating')) || 0;
          card.classList.toggle('rating-hide', threshold > 0 && rating < threshold);
        });
      };
      ratingInputs.forEach((input) => input.addEventListener('change', applyRatingFilter));
    }
  });
{% endjavascript %}

{% schema %}
{
  "name": "t:general.main_collection",
  "settings": []
}
{% endschema %}
