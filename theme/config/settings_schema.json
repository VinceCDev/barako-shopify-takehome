[
  {
    "name": "theme_info",
    "theme_name": "Skeleton",
    "theme_version": "0.1.0",
    "theme_author": "Shopify",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.branding",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "t:labels.favicon",
        "info": "t:labels.favicon_info"
      }
    ]
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "default": "instrument_sans_n5",
        "label": "t:labels.heading_font",
        "info": "t:labels.heading_font_info"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "default": "instrument_sans_n4",
        "label": "t:labels.body_font"
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color",
        "id": "color_background",
        "default": "#F6F2EC",
        "label": "t:labels.background",
        "info": "t:labels.color_background_info"
      },
      {
        "type": "color",
        "id": "color_surface",
        "default": "#ECE5DB",
        "label": "t:labels.surface",
        "info": "t:labels.color_surface_info"
      },
      {
        "type": "color",
        "id": "color_text",
        "default": "#1B1612",
        "label": "t:labels.text",
        "info": "t:labels.color_text_info"
      },
      {
        "type": "color",
        "id": "color_primary",
        "default": "#4A2C1D",
        "label": "t:labels.primary",
        "info": "t:labels.color_primary_info"
      }
    ]
  },
  {
    "name": "t:general.products",
    "settings": [
      {
        "type": "collection",
        "id": "coffee_collection",
        "label": "t:labels.coffee_collection",
        "info": "t:labels.coffee_collection_info"
      },
      {
        "type": "collection",
        "id": "brewing_gear_collection",
        "label": "t:labels.brewing_gear_collection",
        "info": "t:labels.brewing_gear_collection_info"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 32
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 24,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 8
      }
    ]
  }
]
