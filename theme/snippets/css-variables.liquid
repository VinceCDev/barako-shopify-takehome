{% style %}
  {% # Loads all font variations with display: swap %}
  {{ settings.type_heading_font | font_face: font_display: 'swap' }}
  {{ settings.type_heading_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
  {{ settings.type_body_font | font_face: font_display: 'swap' }}
  {{ settings.type_body_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
  {{ settings.type_body_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}

  :root {
    /* Fonts */
    --font-heading--family: {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }};
    --font-heading--style: {{ settings.type_heading_font.style }};
    --font-heading--weight: {{ settings.type_heading_font.weight }};
    --font-body--family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
    --font-body--style: {{ settings.type_body_font.style }};
    --font-body--weight: {{ settings.type_body_font.weight }};

    /* Brand palette */
    --color-espresso: {{ settings.color_text }};
    --color-roast: {{ settings.color_primary }};
    --color-terracotta: {{ settings.color_accent }};
    --color-cream: {{ settings.color_surface }};
    --color-paper: {{ settings.color_background }};

    /* Semantic colors */
    --color-text: var(--color-espresso);
    --color-background: var(--color-paper);
    --color-surface: var(--color-cream);
    --color-primary: var(--color-roast);
    --color-primary-hover: color-mix(in srgb, var(--color-roast) 85%, black);
    --color-accent: var(--color-terracotta);
    /* Raw terracotta is ~4.2:1 on paper, just under AA for text.
       Use -strong wherever text or icons sit directly on the accent color. */
    --color-accent-strong: color-mix(in srgb, var(--color-terracotta) 82%, black);
    --color-accent-strong-hover: color-mix(in srgb, var(--color-terracotta) 65%, black);
    --color-border: color-mix(in srgb, var(--color-espresso) 18%, transparent);
    --color-on-primary: var(--color-paper);
    --color-on-accent: var(--color-paper);

    /* Legacy alias kept for compatibility with existing theme code */
    --color-foreground: var(--color-text);

    /* Layout */
    --page-width: {{ settings.max_page_width }};
    --page-margin: {{ settings.min_page_margin }}px;

    /* Spacing scale */
    --space-1: 0.25rem;
    --space-2: 0.5rem;
    --space-3: 0.75rem;
    --space-4: 1rem;
    --space-5: 1.5rem;
    --space-6: 2rem;
    --space-7: 3rem;
    --space-8: 4rem;

    /* Radius scale */
    --radius-sm: 4px;
    --radius-md: 8px;
    --radius-lg: 16px;
    --radius-full: 999px;
    --style-border-radius-inputs: {{ settings.input_corner_radius }}px;

    /* Type scale */
    --font-size-xs: 0.75rem;
    --font-size-sm: 0.875rem;
    --font-size-base: 1rem;
    --font-size-md: 1.125rem;
    --font-size-lg: 1.5rem;
    --font-size-xl: 2rem;
    --font-size-2xl: 2.5rem;
    --font-size-3xl: 3rem;
    --line-height-tight: 1.15;
    --line-height-base: 1.5;

    /* Icons */
    --icon-stroke-width: 1.5;
  }
{% endstyle %}
