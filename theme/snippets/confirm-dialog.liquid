{% doc %}
  Global confirmation dialog, rendered once in the layout. Other scripts
  call window.BarakoConfirm.show({ title, message, confirmLabel,
  cancelLabel }) and get back a Promise that resolves true (confirmed) or
  false (cancelled/dismissed) — used before destructive actions like
  removing a cart line, so a stray tap doesn't lose an item.

  @example
  {% render 'confirm-dialog' %}
{% enddoc %}

<dialog class="confirm-dialog" data-confirm-dialog>
  <div class="confirm-dialog__icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 8v5"></path>
      <circle cx="12" cy="16.5" r="0.75" fill="currentColor" stroke="none"></circle>
      <circle cx="12" cy="12" r="9.5"></circle>
    </svg>
  </div>
  <p class="confirm-dialog__title" data-confirm-title></p>
  <p class="confirm-dialog__message" data-confirm-message></p>
  <div class="confirm-dialog__actions">
    <button type="button" class="confirm-dialog__cancel" data-confirm-cancel></button>
    <button type="button" class="confirm-dialog__confirm" data-confirm-confirm></button>
  </div>
</dialog>

{% stylesheet %}
  .confirm-dialog {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    margin: 0;
    padding: var(--space-7) var(--space-6) var(--space-6);
    border: none;
    border-radius: var(--radius-md);
    width: min(90vw, 24rem);
    text-align: center;
    background-color: var(--color-background);
    box-shadow: 0 1rem 3rem rgba(0, 0, 0, 0.2);
  }
  .confirm-dialog::backdrop {
    background-color: color-mix(in srgb, var(--color-ink) 55%, transparent);
  }

  .confirm-dialog__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    margin-bottom: var(--space-4);
    border-radius: 50%;
    background-color: #C1462E;
    color: #fff;
  }
  .confirm-dialog__icon svg {
    width: 1.5rem;
  }

  .confirm-dialog__title {
    font-size: var(--font-size-md);
    font-weight: 600;
  }
  .confirm-dialog__message {
    margin-top: var(--space-2);
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .confirm-dialog__actions {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
  .confirm-dialog__cancel,
  .confirm-dialog__confirm {
    flex: 1 1 0;
    min-height: 2.75rem;
    border-radius: var(--radius-sm);
    font-size: var(--font-size-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    cursor: pointer;
  }
  .confirm-dialog__cancel {
    border: 1px solid var(--color-border);
    background-color: var(--color-surface);
    color: var(--color-text);
  }
  .confirm-dialog__confirm {
    border: 1px solid #C1462E;
    background-color: #C1462E;
    color: #fff;
  }
{% endstylesheet %}

{% javascript %}
  window.BarakoConfirm = (function () {
    var dialog = document.querySelector('[data-confirm-dialog]');
    if (!dialog) return { show: function () { return Promise.resolve(true); } };

    var titleEl = dialog.querySelector('[data-confirm-title]');
    var messageEl = dialog.querySelector('[data-confirm-message]');
    var cancelButton = dialog.querySelector('[data-confirm-cancel]');
    var confirmButton = dialog.querySelector('[data-confirm-confirm]');
    var activeResolve = null;

    function settle(result) {
      if (dialog.open) dialog.close();
      if (activeResolve) {
        activeResolve(result);
        activeResolve = null;
      }
    }

    cancelButton.addEventListener('click', function () {
      settle(false);
    });
    confirmButton.addEventListener('click', function () {
      settle(true);
    });
    dialog.addEventListener('cancel', function () {
      // Fires on Escape; dialog closes itself, just settle the promise.
      activeResolve && activeResolve(false);
      activeResolve = null;
    });
    dialog.addEventListener('click', function (event) {
      if (event.target === dialog) settle(false);
    });

    function show(options) {
      options = options || {};
      titleEl.textContent = options.title || 'Are you sure?';
      messageEl.textContent = options.message || '';
      cancelButton.textContent = options.cancelLabel || 'Cancel';
      confirmButton.textContent = options.confirmLabel || 'Remove';

      return new Promise(function (resolve) {
        activeResolve = resolve;
        dialog.showModal();
      });
    }

    return { show: show };
  })();
{% endjavascript %}
