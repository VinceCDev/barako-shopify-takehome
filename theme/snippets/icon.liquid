{% doc %}
  Renders one inline line-style icon (stroke currentColor, 1.25 width),
  in the spirit of Lucide's icon set. No icon fonts, no CDN.

  @param {string} name - One of: menu, cart, account, arrow-right, filter,
    chevron-left, chevron-right, close, minus, plus, check, search,
    map-pin, phone, mail, clock, star, heart, eye, home, trash

  @example
  {% render 'icon', name: 'cart' %}
{% enddoc %}

{% case name %}
  {% when 'menu' %}
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
      <path d="M3.5 6.5h17M3.5 12h17M3.5 17.5h17" stroke="currentColor" stroke-width="var(--icon-stroke-width)" stroke-linecap="round" />
    </svg>

  {% when 'cart' %}
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
      <path
        d="M3.5 6.5h2.4l.7 11a2 2 0 0 0 2 1.9h7.8a2 2 0 0 0 2-1.9l.7-8.6H6.9"
        stroke="currentColor"
        stroke-width="var(--icon-stroke-width)"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      <path
        d="M9 9.5V7.8a3 3 0 0 1 3-3v0a3 3 0 0 1 3 3V9.5"
        stroke="currentColor"
        stroke-width="var(--icon-stroke-width)"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>

  {% when 'account' %}
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
      <circle cx="12" cy="8.25" r="3.25" stroke="currentColor" stroke-width="var(--icon-stroke-width)" />
      <path
        d="M5.5 19c1.2-3.2 3.9-5 6.5-5s5.3 1.8 6.5 5"
        stroke="currentColor"
        stroke-width="var(--icon-stroke-width)"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>

  {% when 'arrow-right' %}
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
      <path
        d="M4 12h16M13.5 5.5 20 12l-6.5 6.5"
        stroke="currentColor"
        stroke-width="var(--icon-stroke-width)"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>

  {% when 'filter' %}
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
      <path
        d="M4 7h16M8 12h8M11 17h2"
        stroke="currentColor"
        stroke-width="var(--icon-stroke-width)"
        stroke-linecap="round"
      />
    </svg>

  {% when 'chevron-left' %}
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
      <path
        d="M15 5.5 8.5 12l6.5 6.5"
        stroke="currentColor"
        stroke-width="var(--icon-stroke-width)"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>

  {% when 'chevron-right' %}
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
      <path
        d="M9 5.5 15.5 12 9 18.5"
        stroke="currentColor"
        stroke-width="var(--icon-stroke-width)"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>

  {% when 'chevron-down' %}
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
      <path
        d="M5.5 9 12 15.5 18.5 9"
        stroke="currentColor"
        stroke-width="var(--icon-stroke-width)"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>

  {% when 'close' %}
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
      <path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="var(--icon-stroke-width)" stroke-linecap="round" />
    </svg>

  {% when 'minus' %}
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
      <path d="M5 12h14" stroke="currentColor" stroke-width="var(--icon-stroke-width)" stroke-linecap="round" />
    </svg>

  {% when 'plus' %}
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
      <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="var(--icon-stroke-width)" stroke-linecap="round" />
    </svg>

  {% when 'check' %}
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
      <path d="M5 12.5 10 17.5 19 7" stroke="currentColor" stroke-width="var(--icon-stroke-width)" stroke-linecap="round" stroke-linejoin="round" />
    </svg>

  {% when 'search' %}
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
      <circle cx="10.5" cy="10.5" r="6.5" stroke="currentColor" stroke-width="var(--icon-stroke-width)" />
      <path d="M19 19l-4-4" stroke="currentColor" stroke-width="var(--icon-stroke-width)" stroke-linecap="round" />
    </svg>

  {% when 'map-pin' %}
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
      <path
        d="M12 21s7-6.5 7-11.5A7 7 0 0 0 5 9.5C5 14.5 12 21 12 21Z"
        stroke="currentColor"
        stroke-width="var(--icon-stroke-width)"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      <circle cx="12" cy="9.5" r="2.25" stroke="currentColor" stroke-width="var(--icon-stroke-width)" />
    </svg>

  {% when 'phone' %}
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
      <path
        d="M5 4.5h3.2l1.3 4.3-2 1.7a11 11 0 0 0 5.9 5.9l1.7-2 4.3 1.3V19a1.5 1.5 0 0 1-1.6 1.5A15 15 0 0 1 4 6.1 1.5 1.5 0 0 1 5.5 4.5Z"
        stroke="currentColor"
        stroke-width="var(--icon-stroke-width)"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>

  {% when 'mail' %}
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
      <rect x="3.5" y="5.5" width="17" height="13" rx="1" stroke="currentColor" stroke-width="var(--icon-stroke-width)" />
      <path d="M4 6.5 12 13l8-6.5" stroke="currentColor" stroke-width="var(--icon-stroke-width)" stroke-linecap="round" stroke-linejoin="round" />
    </svg>

  {% when 'clock' %}
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
      <circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="var(--icon-stroke-width)" />
      <path d="M12 7.5V12l3 2" stroke="currentColor" stroke-width="var(--icon-stroke-width)" stroke-linecap="round" stroke-linejoin="round" />
    </svg>

  {% when 'star' %}
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
      <path
        d="m12 4 2.4 5.2 5.6.6-4.2 3.9 1.2 5.7L12 16.5l-5 2.9 1.2-5.7-4.2-3.9 5.6-.6Z"
        stroke="currentColor"
        stroke-width="var(--icon-stroke-width)"
        stroke-linejoin="round"
      />
    </svg>

  {% when 'heart' %}
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
      <path
        d="M12 19.5s-7.5-4.6-7.5-10A4.25 4.25 0 0 1 12 6.8 4.25 4.25 0 0 1 19.5 9.5c0 5.4-7.5 10-7.5 10Z"
        stroke="currentColor"
        stroke-width="var(--icon-stroke-width)"
        stroke-linejoin="round"
      />
    </svg>

  {% when 'eye' %}
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
      <path
        d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12Z"
        stroke="currentColor"
        stroke-width="var(--icon-stroke-width)"
        stroke-linejoin="round"
      />
      <circle cx="12" cy="12" r="2.5" stroke="currentColor" stroke-width="var(--icon-stroke-width)" />
    </svg>

  {% when 'home' %}
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
      <path
        d="M4 11.5 12 4l8 7.5M6 9.5V20h12V9.5"
        stroke="currentColor"
        stroke-width="var(--icon-stroke-width)"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>

  {% when 'trash' %}
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
      <path
        d="M4 7h16M9.5 7V5a1.5 1.5 0 0 1 1.5-1.5h2A1.5 1.5 0 0 1 14.5 5v2M6.5 7l.7 12a2 2 0 0 0 2 1.9h5.6a2 2 0 0 0 2-1.9l.7-12"
        stroke="currentColor"
        stroke-width="var(--icon-stroke-width)"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
{% endcase %}
