{% doc %}
  Renders one inline line-style icon (stroke currentColor, 1.25 width),
  in the spirit of Lucide's icon set. No icon fonts, no CDN.

  @param {string} name - One of: menu, cart, account, arrow-right

  @example
  {% render 'icon', name: 'cart' %}
{% enddoc %}

{% case name %}
  {% when 'menu' %}
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
      <path d="M3.5 6.5h17M3.5 12h17M3.5 17.5h17" stroke="currentColor" stroke-width="var(--icon-stroke-width)" stroke-linecap="round" />
    </svg>

  {% when 'cart' %}
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
      <path
        d="M3.5 6.5h2.4l.7 11a2 2 0 0 0 2 1.9h7.8a2 2 0 0 0 2-1.9l.7-8.6H6.9"
        stroke="currentColor"
        stroke-width="var(--icon-stroke-width)"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      <path
        d="M9 9.5V7.8a3 3 0 0 1 3-3v0a3 3 0 0 1 3 3V9.5"
        stroke="currentColor"
        stroke-width="var(--icon-stroke-width)"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>

  {% when 'account' %}
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
      <circle cx="12" cy="8.25" r="3.25" stroke="currentColor" stroke-width="var(--icon-stroke-width)" />
      <path
        d="M5.5 19c1.2-3.2 3.9-5 6.5-5s5.3 1.8 6.5 5"
        stroke="currentColor"
        stroke-width="var(--icon-stroke-width)"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>

  {% when 'arrow-right' %}
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
      <path
        d="M4 12h16M13.5 5.5 20 12l-6.5 6.5"
        stroke="currentColor"
        stroke-width="var(--icon-stroke-width)"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
{% endcase %}
