{% doc %}
  Renders a 1-5 scale as five small squares, with the number shown as real
  text alongside so the reading never depends on the marks or color alone.

  @param {string} label - The visible label for the scale (e.g. "Acidity")
  @param {number} value - A value from 1 to 5

  @example
  {% render 'flavor-bar', label: 'Acidity', value: product.metafields.custom.acidity.value %}
{% enddoc %}

{% liquid
  assign clamped_value = value | at_most: 5 | at_least: 0
%}

<div class="flavor-scale">
  <span class="flavor-scale__label">{{ label }}</span>
  <span class="flavor-scale__marks" aria-hidden="true">
    {% for i in (1..5) %}
      <span class="flavor-scale__mark{% if i <= clamped_value %} flavor-scale__mark--filled{% endif %}"></span>
    {% endfor %}
  </span>
  <span class="flavor-scale__value">{{ 'sections.flavor_profile.out_of_5' | t: value: clamped_value }}</span>
</div>
