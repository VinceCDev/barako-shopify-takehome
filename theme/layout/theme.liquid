<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    {% comment %}
      Flips to "js" before first paint so CSS can hide JS-only/no-JS-only
      fallback UI correctly either way (e.g. the product variant picker).
    {% endcomment %}
    <script>document.documentElement.classList.replace('no-js', 'js');</script>

    {% comment %}
      Favicon: the merchant's own upload if set, otherwise the bundled
      brand mark (assets/logo.png) so the tab icon isn't blank by default.
    {% endcomment %}
    {% liquid
      assign favicon_url = 'logo.png' | asset_url
      if settings.favicon
        assign favicon_url = settings.favicon | image_url: width: 32
      endif
    %}
    <link rel="icon" href="{{ favicon_url }}" type="image/png" sizes="32x32">

    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% comment %}
      Font preloading:
      1. Preconnect to font CDN for faster connection
      2. Preload only the critical font variant (base weight)
      3. Additional variants load on-demand via @font-face
    {% endcomment %}
    {% unless settings.type_body_font.system? and settings.type_heading_font.system? %}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {% endunless %}

    {% comment %} Preload the base font variants for initial page render {% endcomment %}
    {% unless settings.type_body_font.system? %}
      {{ settings.type_body_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endunless %}
    {% unless settings.type_heading_font.system? %}
      {{ settings.type_heading_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endunless %}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {% comment %}
      Small shared helper for updating the header cart count from the
      product and cart pages; harmless no-op everywhere else.
    {% endcomment %}
    <script src="{{ 'cart-utils.js' | asset_url }}" defer></script>
    <script src="{{ 'favorites.js' | asset_url }}" defer></script>

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {{ content_for_header }}
  </head>

  <body data-template="{{ template.name }}">
    <a href="#MainContent" class="skip-link">{{ 'general.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% render 'quick-view-modal' %}
    {% render 'confirm-dialog' %}
    {% render 'payment-method-dialog' %}
    {% render 'toast' %}
  </body>
</html>
